# Copie este arquivo para .env.local (que fica fora do Git) e preencha.
# Usado só pelo script de importação (scripts/importar_excel.mjs), no seu computador.
# O site em si não lê este arquivo: o GitHub Pages não tem variáveis de ambiente,
# então a URL e a chave anon do site ficam em config.js (são públicas por natureza).

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chave secreta (service_role). Vê todos os dados e ignora o RLS: só no .env.local, nunca no site.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço do site, para o link do convite por e-mail
SITE_URL=https://paivanutri.vercel.app/
